# ────────────────────────────────────────────────────────
#  Ionix Partner — Environment Variables
#  Copy this file to .env and fill in all values.
#  NEVER commit the actual .env file to version control.
# ────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
POSTGRES_DB=ionix_partner
POSTGRES_USER=ionix_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT Secrets (generate with: openssl rand -base64 64) ─
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_minimum_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Telegram Bot ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAABBBCCC-your-bot-token
TELEGRAM_CHAT_ID=-100123456789

# ── Upload Settings ───────────────────────────────────────
MAX_FILE_SIZE=10485760   # 10 MB in bytes

# ── CORS / App URLs ──────────────────────────────────────
# CORS_ORIGIN = domeniul complet al frontend-ului
CORS_ORIGIN=https://partner.pin.md

# NEXT_PUBLIC_API_URL:
#   - Producție cu nginx:  lasă GOL (browser-ul trimite relativ, nginx proxiază)
#   - Dev local:           http://localhost:4000
#   - Synology fără nginx: http://<IP_NAS>:<PORT_API>
NEXT_PUBLIC_API_URL=

# ── Synology NAS specific ─────────────────────────────────
# UPLOAD_DIR este calea din container, mapată la un shared folder NAS
# via named volume în docker-compose.yml (uploads_data)
UPLOAD_DIR=/app/uploads

# ── Integrare cu AIONA (sistemul intern PRIMINVESTNORD) ──────────────────────
# Cererile depuse de parteneri pleacă în AIONA, iar contractul de tipărit vine
# de acolo. Acelaşi secret în ambele aplicaţii — cu el se recunosc între ele.
# Lăsate goale, integrarea tace: Ionix lucrează exact ca până acum.
AIONA_API_URL=
IONIX_SECRET=
